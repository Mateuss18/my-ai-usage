<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0-windows10.0.22000.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.22000.0</TargetPlatformMinVersion>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <!-- tray callback check compiles the production source into this runner -->
  <ItemGroup>
    <ProjectReference Include="..\..\src\MyAiUsage.Core\MyAiUsage.Core.csproj" />
    <Compile Include="..\..\src\MyAiUsage.App\TrayIcon.cs" Link="TrayIcon.cs" />
    <Compile Include="..\..\src\MyAiUsage.App\StartupTaskManager.cs" Link="StartupTaskManager.cs" />
  </ItemGroup>

</Project>
