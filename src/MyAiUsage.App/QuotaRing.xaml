<UserControl
    x:Class="MyAiUsage.App.QuotaRing"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <StackPanel Width="180" Spacing="8" HorizontalAlignment="Center">
        <Grid Width="144" Height="144" HorizontalAlignment="Center">
            <Ellipse Stroke="#66707A" StrokeThickness="10" />
            <Ellipse x:Name="Progress"
                     Stroke="#66707A"
                     StrokeThickness="10"
                     StrokeStartLineCap="Round"
                     StrokeEndLineCap="Round"
                     RenderTransformOrigin="0.5,0.5">
                <Ellipse.RenderTransform>
                    <RotateTransform Angle="-90" />
                </Ellipse.RenderTransform>
            </Ellipse>
            <Image x:Name="LogoImage"
                   Width="52"
                   Height="52"
                   HorizontalAlignment="Center"
                   VerticalAlignment="Center"
                   Stretch="Uniform"
                   Source="ms-appx:///Assets/gpt-icon-black.png"
                   ImageFailed="OnLogoImageFailed"
                   IsHitTestVisible="False"
                   AutomationProperties.AccessibilityView="Raw" />
            <TextBlock x:Name="LogoFallbackText"
                       Text="Codex"
                       Visibility="Collapsed"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       Margin="0,34,0,0"
                       IsHitTestVisible="False"
                       AutomationProperties.Name="Codex" />
            <TextBlock x:Name="PercentText"
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"
                       FontSize="24"
                       FontWeight="SemiBold" />
        </Grid>
        <TextBlock x:Name="UsageText" TextAlignment="Center" TextWrapping="Wrap" />
        <TextBlock x:Name="TitleText" TextAlignment="Center" TextWrapping="Wrap" />
        <TextBlock x:Name="ResetText" TextAlignment="Center" TextWrapping="Wrap" />
        <TextBlock x:Name="StateText" TextAlignment="Center" FontWeight="SemiBold" />
    </StackPanel>
</UserControl>
