<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.22000.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.22000.0</TargetPlatformMinVersion>
    <Platforms>x64</Platforms>
    <PlatformTarget>x64</PlatformTarget>
    <RuntimeIdentifiers>win-x64</RuntimeIdentifiers>
    <RootNamespace>MyAiUsage.App</RootNamespace>
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>MSIX</WindowsPackageType>
    <EnableMsixTooling>true</EnableMsixTooling>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\MyAiUsage.Core\MyAiUsage.Core.csproj" />
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="2.4.0" />
    <AppxManifest Include="Package.appxmanifest">
      <SubType>Designer</SubType>
    </AppxManifest>
  </ItemGroup>

  <Target Name="ResolveStartupTaskExecutable" AfterTargets="AfterGenerateAppxManifest">
    <XmlPoke
        XmlInputPath="$(FinalAppxManifestName)"
        Query="/*[local-name()='Package']/*[local-name()='Applications']/*[local-name()='Application']/*[local-name()='Extensions']/*[local-name()='Extension'][@Category='windows.startupTask']/@Executable"
        Value="$(TargetName).exe" />
  </Target>

</Project>
