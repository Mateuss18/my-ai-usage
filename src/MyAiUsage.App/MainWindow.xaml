<Window
    x:Class="MyAiUsage.App.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Title="My AI Usage">
    <Grid x:Name="Root" AutomationProperties.Name="My AI Usage" Loaded="OnLoaded">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Margin="24" Spacing="8">
            <TextBlock Text="Quotas do Codex" FontSize="28" FontWeight="SemiBold" />
            <TextBlock x:Name="StatusText" Text="Carregando" AutomationProperties.LiveSetting="Polite" />
            <TextBlock x:Name="LastUpdatedText" Text="Último snapshot completo: indisponível" />
            <Button Content="Atualizar" Click="OnRefreshClicked" AutomationProperties.Name="Atualizar quotas do Codex" />
            <ToggleSwitch x:Name="StartupToggle"
                          Header="Iniciar com o Windows"
                          OnContent="Ligado"
                          OffContent="Desligado"
                          IsEnabled="False"
                          Toggled="OnStartupToggled"
                          AutomationProperties.Name="Iniciar My AI Usage com o Windows" />
            <TextBlock x:Name="StartupStateText"
                       AutomationProperties.Name="Estado do auto-start"
                       AutomationProperties.LiveSetting="Polite" />
            <TextBlock x:Name="StartupReasonText"
                       TextWrapping="Wrap"
                       AutomationProperties.Name="Motivo do auto-start" />
        </StackPanel>
        <ScrollViewer Grid.Row="1" Padding="24,0,24,24">
            <StackPanel x:Name="QuotaPanel" Spacing="24" />
        </ScrollViewer>
    </Grid>
</Window>
